class PeripheryCli < Formula
  desc "Periphery"
  homepage "https://periphery.pro"
  version "{{VERSION}}"
  license :cannot_represent

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/periphery-pro/cli-releases/releases/download/{{TAG}}/periphery-cli_{{VERSION}}_macos_arm64.zip"
      sha256 "{{MACOS_ARM64_SHA256}}"
    else
      url "https://github.com/periphery-pro/cli-releases/releases/download/{{TAG}}/periphery-cli_{{VERSION}}_macos_x86_64.zip"
      sha256 "{{MACOS_X86_64_SHA256}}"
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url "https://github.com/periphery-pro/cli-releases/releases/download/{{TAG}}/periphery-cli_{{VERSION}}_linux_arm64.zip"
      sha256 "{{LINUX_ARM64_SHA256}}"
    else
      url "https://github.com/periphery-pro/cli-releases/releases/download/{{TAG}}/periphery-cli_{{VERSION}}_linux_x86_64.zip"
      sha256 "{{LINUX_X86_64_SHA256}}"
    end
  end

  conflicts_with "periphery"

  def install
    libexec.install "periphery", "retention.map"
    bin.install_symlink libexec/"periphery"

    if OS.mac?
      odie <<~EOS unless MacOS::CLT.installed?
        Periphery requires the Xcode Command Line Tools at #{MacOS::CLT::PKG_PATH}.
        Install them with:
          xcode-select --install
      EOS

      libexec.install "libswiftDemangle.dylib"
      MachO::Tools.add_rpath libexec/"periphery", "#{MacOS::CLT::PKG_PATH}/usr/lib"
      system "codesign", "--force", "--sign", "-",
             "--preserve-metadata=entitlements,flags,runtime", libexec/"periphery"
    else
      libexec.install Dir["libIndexStore.*", "libswiftDemangle.*"]
    end

    doc.install "LICENSE.md", "THIRD_PARTY_NOTICES.txt"
  end

  test do
    system bin/"periphery", "version"
    assert_path_exists libexec/"retention.map"
    assert_equal "PRTM", (libexec/"retention.map").binread(4)
    assert_path_exists doc/"LICENSE.md"
    assert_path_exists doc/"THIRD_PARTY_NOTICES.txt"

    if OS.mac?
      assert_path_exists libexec/"libswiftDemangle.dylib"
      assert_includes (libexec/"periphery").rpaths, "#{MacOS::CLT::PKG_PATH}/usr/lib"
      refute_path_exists libexec/"libIndexStore.dylib"
      system "codesign", "--verify", "--strict", libexec/"periphery"
    end
  end
end
